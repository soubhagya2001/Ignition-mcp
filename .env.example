# Optional environment file — copy to .env only if you need overrides.
# The MCP auto-discovers a local Ignition install, so no configuration is required.

# --- Direct control (no API key needed) ---
# Point at the Ignition install to read/write projects, scripts and views on disk.
# IGNITION_INSTALL_PATH=C:\Program Files\Inductive Automation\Ignition

# --- Gateway connection (optional) ---
# IGNITION_GATEWAY_URL=http://localhost:8088
# Gateway web-session login (cookie auth). No API token required.
# IGNITION_USERNAME=admin
# IGNITION_PASSWORD=password

# --- API key (optional fallback only) ---
# Ignition API keys are sent as X-Ignition-API-Token. Not needed for session login.
# IGNITION_API_TOKEN=

# --- Project context (optional — first project is used by default) ---
# IGNITION_PROJECT=MyProject

# --- Behaviour flags ---
# IGNITION_READONLY=false         # Set false to allow writes (default: true)
# IGNITION_LOG_LEVEL=INFO         # DEBUG, INFO, WARNING, ERROR
# IGNITION_TIMEOUT=30             # HTTP request timeout in seconds
# IGNITION_SCAN_NETWORK=true      # Allow mDNS/port discovery
# IGNITION_SCAN_TIMEOUT=2         # Seconds per discovery probe
# IGNITION_VERIFY_SSL=false       # Ignition often uses self-signed certificates
# IGNITION_API_PREFIX=/data/api/v1

# --- Modules to enable (comma-separated, default: all) ---
# IGNITION_MODULES=gateway,tags,perspective,scripting,alarms,database,projects,security

# --- Write snapshots (local file writes) ---
# IGNITION_MCP_SNAPSHOT_DIR=~/.ignition/mcp/snapshots
# IGNITION_MCP_SNAPSHOT_LIMIT=20

# --- Transport ---
# IGNITION_TRANSPORT=stdio        # stdio (default), sse, http
# IGNITION_HOST=127.0.0.1
# IGNITION_PORT=8080              # Port for sse/http transport
